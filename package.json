{
  "name": "poketracker",
  "version": "1.0.0",
  "scripts": {
    "format:check": "prettier --check ./src",
    "format": "prettier --write ./src",
    "main": "tsx ./src/scripts/main.ts",
    "type:check": "tsc --noEmit"
  },
  "type": "module",
  "devDependencies": {
    "@types/cheerio": "0.22.35",
    "@types/node": "24.9.2",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "1.13.1",
    "cheerio": "1.1.2",
    "date-fns": "4.1.0",
    "googleapis": "170.0.0",
    "zod": "4.1.12"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  }
}
